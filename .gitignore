# === OS / editores ===
.DS_Store
Thumbs.db
*.swp
.idea/

# === Secrets / entorno ===
# `.env.*` ignora TODO, y los `!` re-admiten SÓLO las plantillas (que no llevan valores). Ojo con el
# orden: un `!` sólo funciona después de la regla que ignora. Sin el `!.env.local.example` de abajo,
# una plantilla nueva es invisible para git — `apps/web/.env.local.example` está trackeado sólo
# porque en su momento se forzó, y eso escondía el agujero.
.env
.env.*
!.env.example
!.env.local.example
!.env.staging.local.example
!.env.e2e.local.example
*.pem

# === Node / Next.js ===
node_modules/
.next/
out/
build/
dist/
.turbo/
.pnpm-store/
npm-debug.log*
yarn-error.log*
*.tsbuildinfo
next-env.d.ts

# === Python (apps/api, services/worker) ===
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.ruff_cache/
.mypy_cache/
*.egg-info/
.coverage
htmlcov/
coverage/

# === Supabase CLI (local) ===
supabase/.branches/
supabase/.temp/

# === Deploy ===
.vercel

# === Logs ===
*.log
# (el bloque "Secrets / entorno" de arriba ya cubre .env* con sus excepciones;
# no repetir `.env*` acá — una segunda regla sin `!` después de la negación
# la vuelve a ignorar y esconde `.env.example` del repo.)
